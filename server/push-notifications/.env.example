# Job start / 30-min reminder scheduler (cron every minute)
JOB_SCHEDULER_ENABLED=true
# Fallback timezone when a driver has no device timezone saved yet (IANA name, e.g. Europe/London)
JOB_TIMEZONE=UTC

# Document expiry reminders (30d, 14d, 7d, 48h, 24h) — per-user device timezone at 21:35 local, JOB_TIMEZONE fallback
DOCUMENT_EXPIRY_SCHEDULER_ENABLED=true

# Auto Off-Road fleet vehicles when MOT / insurance / taxi plate actually expire (Europe/London calendar date)
VEHICLE_DOC_EXPIRY_OFF_ROAD_ENABLED=true
DOCUMENT_EXPIRY_TIMEZONE=Europe/London

# Private vehicles: keep assignment, remove driver from active/upcoming jobs, priority admin alerts
PRIVATE_VEHICLE_DOC_EXPIRY_ENABLED=true
